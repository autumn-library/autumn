#Использовать "../tests/ТестКлассы"

#Область ОбработчикиСобытий

// Создает бенчмарк инициализации поделки.
//
// Инициализация поделки - тяжелая операция со сканированием всех известных типов,
// поэтому замеряется ровно один вызов на итерацию без автоподбора количества вызовов.
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(1)
&КоличествоВызововЗаИтерацию(1)
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Создает и запускает поделку со всеми тестовыми желудями.
&Бенчмарк(Наименование = "Инициализация поделки")
Процедура ИнициализацияПоделки() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#КонецОбласти
