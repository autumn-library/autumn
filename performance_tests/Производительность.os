#Использовать asserts
#Использовать benchmark
#Использовать "./Бенчмарки"

// Тесты производительности.
//
// Каждый тест запускает один бенчмарк benchos и сравнивает среднее время выполнения
// одной операции с порогом. Пороги намеренно взяты с большим запасом: задача - ловить
// кратные деградации, а не шум раннера CI.

#Область Тесты

&Тест
Процедура СозданиеКомпанейскогоЖелудяУкладываетсяВПорог() Экспорт

	ПроверитьБенчмаркСозданияЖелудей("СозданиеКомпанейскогоЖелудя", 0.3);

КонецПроцедуры

&Тест
Процедура СозданиеКомпанейскогоЖелудяИзТабакеркиУкладываетсяВПорог() Экспорт

	ПроверитьБенчмаркСозданияЖелудей("СозданиеКомпанейскогоЖелудяИзТабакерки", 0.3);

КонецПроцедуры

&Тест
Процедура СозданиеЖелудяСПластилиномНаПоляхУкладываетсяВПорог() Экспорт

	ПроверитьБенчмаркСозданияЖелудей("СозданиеКомпанейскогоЖелудяСПластилиномНаПолях", 0.9);

КонецПроцедуры

&Тест
Процедура СозданиеЖелудяСПластилиномВКонструктореУкладываетсяВПорог() Экспорт

	ПроверитьБенчмаркСозданияЖелудей("СозданиеКомпанейскогоЖелудяСПластилиномВКонструкторе", 0.9);

КонецПроцедуры

&Тест
Процедура ИнициализацияПоделкиУкладываетсяВПорог() Экспорт

	Конфигурация = Новый КонфигурацияБенчмарков()
		.УстановитьКоличествоИтераций(5)
		.УстановитьКоличествоПрогревочныхИтераций(1)
		.УстановитьКоличествоВызововЗаИтерацию(1)
		.УстановитьМинимальноеКоличествоВызововЗаИтерацию(1);

	ПроверитьБенчмарк(Тип("БенчмаркИнициализацииПоделки"), "ИнициализацияПоделки", 1000, Конфигурация);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьБенчмаркСозданияЖелудей(Знач ИмяБенчмарка, Знач ПорогВМиллисекундах)

	Конфигурация = Новый КонфигурацияБенчмарков()
		.УстановитьКоличествоИтераций(10)
		.УстановитьКоличествоПрогревочныхИтераций(3)
		.УстановитьМинимальноеВремяИтерации(100);

	ПроверитьБенчмарк(Тип("БенчмаркСозданияЖелудей"), ИмяБенчмарка, ПорогВМиллисекундах, Конфигурация);

КонецПроцедуры

Процедура ПроверитьБенчмарк(Знач ТипБенчмарка, Знач ИмяБенчмарка, Знач ПорогВМиллисекундах, Знач Конфигурация)

	ДескрипторыБенчмарков = Новый КоллекцияДескрипторовБенчмарков(ТипБенчмарка);
	ДескрипторБенчмарка = ДескрипторыБенчмарков.НайтиПоИмени(ИмяБенчмарка);

	Ожидаем.Что(
		ДескрипторБенчмарка <> Неопределено,
		СтрШаблон("Бенчмарк <%1> найден", ИмяБенчмарка)
	).ЭтоИстина();

	РезультатЗапуска = Бенчмаркинг.Запустить(ДескрипторБенчмарка, Конфигурация);

	Ожидаем.Что(
		РезультатЗапуска.Запуски.Количество(),
		СтрШаблон("Количество выполненных кейсов бенчмарка <%1>", ИмяБенчмарка)
	).Равно(1);

	Статистика = РезультатЗапуска.Запуски[0].Статистика.ВМиллисекунды();

	Ожидаем.Что(
		Статистика.Среднее,
		СтрШаблон("Среднее время выполнения бенчмарка <%1>, мс", ИмяБенчмарка)
	).Меньше(ПорогВМиллисекундах);

КонецПроцедуры

#КонецОбласти
