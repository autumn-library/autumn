#Использовать "../internal"
#Использовать logos

#Область ОписаниеПеременных

// Соответствие - Значения деталек в виде соответствия
// для последующей передачи в МенеджерПараметров.
//
Перем ЗначенияДеталек;

// Строка - префикс переменных среды, хранящих значения деталек.
//
Перем ПрефиксПеременныхСреды;

// Строка - имя файла (без расширения), в котором хранятся значения деталек.
//
Перем ИмяФайлаСоЗначениямиДеталек;

// Строка - Относительный путь к каталогу, где хранятся файл со значениями деталек.
//
Перем ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек;

// Соответствие: имя поля -> Истина, если поле явно установлено через сеттер.
// Используется для условного применения настроек к строителю.
//
Перем _Установлено;

// СтроительМенеджераПараметров - закэшированный экземпляр строителя.
// Создаётся лениво при первом обращении к ПолучитьСтроительМенеджераПараметров()
// и переиспользуется при повторных вызовах, чтобы пользовательские правки строителя
// (через ОчиститьПровайдеры/ДобавитьПровайдер*/УдалитьПровайдер) дошли до Поделки.
//
Перем _Строитель;

// ПровайдерПараметровСоответствие - inline-провайдер, заведённый устаревшим сеттером
// ЗначенияДеталек. Хранится, чтобы повторный вызов сеттера перенастраивал тот же
// провайдер, а не добавлял в строитель ещё один.
//
Перем _ИнлайнПровайдер;

Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает строитель менеджера параметров с применёнными значениями
// устаревших полей совета, явно установленных через сеттеры
// (ЗначенияДеталек, ПрефиксПеременныхСреды, ИмяФайлаСоЗначениямиДеталек,
// ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек).
//
// Если поле не было явно установлено, дефолт строителя сохраняется.
//
// Строитель кэшируется при первом вызове и возвращается тем же экземпляром
// при последующих вызовах. Это позволяет внешнему коду получить строитель,
// сконфигурировать его (добавить/удалить провайдеры, очистить состав)
// и затем передать СоветДругогоМастера в Поделку - Поделка получит тот же
// строитель со всеми внесёнными правками.
//
// Устаревшие сеттеры, вызванные уже после создания строителя, правят его на месте,
// так что порядок вызовов значения не имеет: старый и новый стиль смешиваются свободно.
//
// Возвращаемое значение:
//   СтроительМенеджераПараметров
//
Функция ПолучитьСтроительМенеджераПараметров() Экспорт

	Если _Строитель = Неопределено Тогда
		_Строитель = Новый СтроительМенеджераПараметров();
		ПрименитьПрефиксПеременныхСреды();
		ПрименитьИмяФайлаСоЗначениямиДеталек();
		ПрименитьДополнительныйКаталогПоиска();
		ПрименитьЗначенияДеталек();
	КонецЕсли;

	Возврат _Строитель;

КонецФункции

// Устарела.
// Установить/получить значения деталек.
//
// Устаревшее API. Рекомендуется использовать
// ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(...).
//
Функция ЗначенияДеталек(НовоеЗначение = Неопределено) Экспорт

	Если НовоеЗначение <> Неопределено Тогда
		ПредупредитьОбУстаревшемМетоде(
			"ЗначенияДеталек", "ДобавитьПровайдерСоответствие(...)"
		);
		ЗначенияДеталек = НовоеЗначение;
		ОтметитьУстановленным("ЗначенияДеталек");
		ПрименитьЗначенияДеталек();
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат ЗначенияДеталек;

КонецФункции

// Устарела. 
// Установить/получить префикс переменных среды, хранящих значения деталек.
//
// Устаревшее API. Рекомендуется использовать
// ПолучитьСтроительМенеджераПараметров().Провайдер("env").Настройки().УстановитьПрефикс(...).
//
Функция ПрефиксПеременныхСреды(НовоеЗначение = Неопределено) Экспорт

	Если НовоеЗначение <> Неопределено Тогда
		ПредупредитьОбУстаревшемМетоде(
			"ПрефиксПеременныхСреды", "Провайдер(""env"").Настройки().УстановитьПрефикс(...)"
		);
		ПрефиксПеременныхСреды = НовоеЗначение;
		ОтметитьУстановленным("ПрефиксПеременныхСреды");
		ПрименитьПрефиксПеременныхСреды();
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат ПрефиксПеременныхСреды;

КонецФункции

// Устарела.
// Установить/получить имя файла (без расширения), в котором хранятся значения деталек.
//
// Устаревшее API. Рекомендуется использовать
// ПолучитьСтроительМенеджераПараметров().ПровайдерФайлов("default").УстановитьИмяФайла(...).
//
Функция ИмяФайлаСоЗначениямиДеталек(НовоеЗначение = Неопределено) Экспорт

	Если НовоеЗначение <> Неопределено Тогда
		ПредупредитьОбУстаревшемМетоде(
			"ИмяФайлаСоЗначениямиДеталек", "ПровайдерФайлов(""default"").УстановитьИмяФайла(...)"
		);
		ИмяФайлаСоЗначениямиДеталек = НовоеЗначение;
		ОтметитьУстановленным("ИмяФайлаСоЗначениямиДеталек");
		ПрименитьИмяФайлаСоЗначениямиДеталек();
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат ИмяФайлаСоЗначениямиДеталек;

КонецФункции

// Устарела.
// Установить/получить относительный путь к каталогу, где хранятся файл со значениями деталек.
//
// Устаревшее API. Рекомендуется использовать
// ПолучитьСтроительМенеджераПараметров().ПровайдерФайлов("default").ДобавитьСтандартныеКаталогиПоиска(...).
//
Функция ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек(НовоеЗначение = Неопределено) Экспорт

	Если НовоеЗначение <> Неопределено Тогда
		ПредупредитьОбУстаревшемМетоде(
			"ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек",
			"ПровайдерФайлов(""default"").ДобавитьСтандартныеКаталогиПоиска(...)"
		);
		ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек = НовоеЗначение;
		ОтметитьУстановленным("ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек");
		ПрименитьДополнительныйКаталогПоиска();
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПредупредитьОбУстаревшемМетоде(Знач ИмяМетода, Знач РекомендуемаяЗамена)

	Лог.Предупреждение("Метод СоветДругогоМастера.%1(...) устарел. Используйте ПолучитьСтроительМенеджераПараметров().%2, настроив строитель до передачи СоветДругогоМастера в Поделку.", ИмяМетода, РекомендуемаяЗамена);

КонецПроцедуры

Процедура ОтметитьУстановленным(Знач ИмяПоля)
	_Установлено.Вставить(ИмяПоля, Истина);
КонецПроцедуры

// Возвращает строитель, если устаревшее поле нужно к нему применить.
//
// Пока строителя нет, применять нечего: значение доедет при его создании.
// Процедуры применения ниже идемпотентны, поэтому зовутся и из сеттеров,
// и из ПолучитьСтроительМенеджераПараметров - порядок вызовов роли не играет.
//
//  Возвращаемое значение:
//   СтроительМенеджераПараметров, Неопределено - строитель либо Неопределено, если применять нечего.
//
Функция СтроительДляПрименения(Знач ИмяПоля)

	Если _Строитель = Неопределено Или НЕ Установлено(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _Строитель;

КонецФункции

// Файловый метапровайдер "default" мог быть снесён через ОчиститьПровайдеры
// или УдалитьПровайдер: тогда настраивать нечего, а падать не за что.
//
Функция ФайловыйПровайдерПоУмолчанию(Знач Строитель)

	Попытка
		Возврат Строитель.ПровайдерФайлов("default");
	Исключение
		Лог.Отладка("Файловый провайдер <default> в строителе отсутствует, настройка пропущена");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ПрименитьПрефиксПеременныхСреды()

	Строитель = СтроительДляПрименения("ПрефиксПеременныхСреды");
	Если Строитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Провайдер = Строитель.Провайдер("env");
	Если Провайдер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Провайдер.Настройки().УстановитьПрефикс(ПрефиксПеременныхСреды);

КонецПроцедуры

Процедура ПрименитьИмяФайлаСоЗначениямиДеталек()

	Строитель = СтроительДляПрименения("ИмяФайлаСоЗначениямиДеталек");
	Если Строитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Метапровайдер = ФайловыйПровайдерПоУмолчанию(Строитель);
	Если Метапровайдер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Метапровайдер.УстановитьИмяФайла(ИмяФайлаСоЗначениямиДеталек);

КонецПроцедуры

Процедура ПрименитьДополнительныйКаталогПоиска()

	Строитель = СтроительДляПрименения("ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек");
	Если Строитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Метапровайдер = ФайловыйПровайдерПоУмолчанию(Строитель);
	Если Метапровайдер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Метапровайдер.ДобавитьСтандартныеКаталогиПоиска(
		ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек
	);

КонецПроцедуры

Процедура ПрименитьЗначенияДеталек()

	Строитель = СтроительДляПрименения("ЗначенияДеталек");
	Если Строитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Строитель мог пересобрать состав через ОчиститьПровайдеры - тогда наш провайдер
	// в менеджере больше не числится и его нужно завести заново.
	Если _ИнлайнПровайдер = Неопределено Или Строитель.Провайдер("inline") = Неопределено Тогда
		_ИнлайнПровайдер = Строитель.ДобавитьПровайдерСоответствие(ЗначенияДеталек, 3, "inline");
	Иначе
		_ИнлайнПровайдер.УстановитьПараметры(ЗначенияДеталек);
	КонецЕсли;

КонецПроцедуры

Функция Установлено(Знач ИмяПоля)
	Возврат _Установлено.Получить(ИмяПоля) = Истина;
КонецФункции

#КонецОбласти

#Область Инициализация

// Советы по созданию поделки, упакованные в объект.
//
Процедура ПриСозданииОбъекта()

	ЗначенияДеталек = Новый Соответствие();
	ПрефиксПеременныхСреды = "";
	ИмяФайлаСоЗначениямиДеталек = "autumn-properties";
	ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек = "src";

	_Установлено = Новый Соответствие;

	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn.application.context");

КонецПроцедуры

#КонецОбласти
