#Использовать "../internal"
#Использовать annotations
#Использовать autumn-collections
#Использовать collectionos
#Использовать configor
#Использовать logos

#Область ОписаниеПеременных

Перем ИнициализированныеЖелудиОдиночки;
Перем БлокировкиОдиночек; // КартаКопированиеПриЗаписи - блокировки создания одиночек по имени
Перем КонтейнерАннотаций;
Перем ФабрикаЖелудей;
Перем СостояниеПриложения;
Перем БлокировкаСостоянияПриложения; // БлокировкаРесурса - упорядочивает запуск приложения и добавление завязей
Перем НапильникиБылиПроинициализированы;
Перем НапильникиИнициализируются; // Булево - поток под БлокировкаИнициализацииНапильников начал их инициализацию
Перем БлокировкаИнициализацииНапильников; // БлокировкаРесурса - пускает инициализировать напильники один поток
Перем Осенизатор;
Перем ПрилепляторЧастиц;
Перем УправляющийПрилепляемымиКоллекциями;

Перем Лог;
Перем МенеджерПараметров;

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область РаботаСЖелудями

// Возвращает определения желудей. Если имя не указано — возвращаются все известные определения.
//
// Параметры:
//   Имя - Строка - Имя желудя, определения которого нужно получить. По умолчанию Неопределено — вернутся все определения.
//
//  Возвращаемое значение:
//   ФиксированноеСоответствие:
//    * Ключ     - Строка - имя желудя
//    * Значение - ОпределениеЖелудя - определение желудя
//
Функция ПолучитьОпределенияЖелудей(Имя = Неопределено) Экспорт
	Если Имя = Неопределено Тогда
		Возврат ФабрикаЖелудей.ПолучитьОпределенияЖелудей();
	Иначе
		ОпределенияЖелудей = Новый Соответствие();
		СписокОпределенийЖелудей = ФабрикаЖелудей.ПолучитьСписокОпределенийЖелудей(Имя);
		Для Каждого ОпределениеЖелудя Из СписокОпределенийЖелудей Цикл
			ОпределенияЖелудей.Вставить(ОпределениеЖелудя.Имя(), ОпределениеЖелудя);
		КонецЦикла;

		Возврат Новый ФиксированноеСоответствие(ОпределенияЖелудей);
	КонецЕсли;
КонецФункции

// Возвращает определения всех зарегистрированных аннотаций.
//
//  Возвращаемое значение:
//   ФиксированноеСоответствие:
//    * Ключ     - Строка - имя аннотации
//    * Значение - ОпределениеАннотации - определение аннотации
//
Функция ПолучитьОпределенияАннотаций() Экспорт
	Возврат КонтейнерАннотаций.ПолучитьОпределенияАннотаций();
КонецФункции

// Возвращает определение желудя по его имени.
//
// Параметры:
//   Имя - Строка - Имя желудя.
//
//  Возвращаемое значение:
//   ОпределениеЖелудя, Неопределено - определение желудя либо Неопределено, если желудь не найден.
//
Функция ПолучитьОпределениеЖелудя(Имя) Экспорт
	Возврат ФабрикаЖелудей.ПолучитьОпределениеЖелудя(Имя);
КонецФункции

// Возвращает определение аннотации по её имени.
//
// Параметры:
//   Имя - Строка - Имя аннотации.
//
//  Возвращаемое значение:
//   ОпределениеАннотации, Неопределено - определение аннотации либо Неопределено, если аннотация не найдена.
//
Функция ПолучитьОпределениеАннотации(Имя) Экспорт
	Возврат КонтейнерАннотаций.ПолучитьОпределениеАннотации(Имя);
КонецФункции

// Находит и возвращает экземпляр желудя по его имени.
//
// Параметры:
//   Имя - Строка - Имя желудя. Имя "Поделка" возвращает сам контекст.
//   ПрилепляемыеЧастицы - Массив из ПрилепляемаяЧастица - Зависимости, передаваемые желудю при создании. По умолчанию Неопределено.
//
//  Возвращаемое значение:
//   Произвольный - экземпляр желудя.
//
Функция НайтиЖелудь(Имя, ПрилепляемыеЧастицы = Неопределено) Экспорт

	Если ВРег(Имя) = ВРег("Поделка") Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ОпределениеЖелудя = ФабрикаЖелудей.ПолучитьОпределениеЖелудя(Имя);

	Если ОпределениеЖелудя = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Не удалось получить определение Желудя по имени Желудя %1", Имя);
	КонецЕсли;

	Если НЕ ОпределениеЖелудя.Спецификация() = СостоянияПриложения.Инициализация() Тогда
		ПроверитьСостояниеВыполнение();

		Если НЕ НапильникиБылиПроинициализированы Тогда
			ПроинициализироватьНапильники();
		КонецЕсли;
	КонецЕсли;

	Если ОпределениеЖелудя.Характер() = ХарактерыЖелудей.Компанейский() Тогда
		Желудь = ИнициализироватьКомпанейскийЖелудь(ОпределениеЖелудя.Имя(), ПрилепляемыеЧастицы);
	ИначеЕсли ОпределениеЖелудя.Характер() = ХарактерыЖелудей.Одиночка() Тогда
		Желудь = ИнициализироватьЖелудьОдиночку(ОпределениеЖелудя.Имя(), ПрилепляемыеЧастицы);
	Иначе
		ВызватьИсключение "Неизвестный характер желудя " + ОпределениеЖелудя.Характер();
	КонецЕсли;

	Возврат Желудь;

КонецФункции

// Находит и возвращает все экземпляры желудей с указанным именем в виде коллекции заданного типа.
//
// Параметры:
//   Имя - Строка - Имя желудей. Имя "Поделка" возвращает сам контекст (только для типа "Массив").
//   ПрилепляемыеЧастицы - Массив из ПрилепляемаяЧастица - Зависимости, передаваемые желудям при создании. По умолчанию Неопределено.
//   ТипЖелудя - Строка - Тип возвращаемой коллекции ("Массив", "Соответствие" и т.п.). По умолчанию "Массив".
//
//  Возвращаемое значение:
//   Произвольный - коллекция найденных экземпляров желудей указанного типа.
//     Желуди, завязь которых вернула Неопределено, в коллекцию не попадают.
//
Функция НайтиЖелуди(Имя, ПрилепляемыеЧастицы = Неопределено, ТипЖелудя = "Массив") Экспорт

	Если ВРег(Имя) = ВРег("Поделка") Тогда

		Если ТипЖелудя <> "Массив" Тогда
			ВызватьИсключение "Прилепление Поделки возможно только в виде массива";
		КонецЕсли;

		Результат = Новый Массив();
		Результат.Добавить(ЭтотОбъект);
		Возврат Новый ФиксированныйМассив(Результат);
	КонецЕсли;

	Результат = УправляющийПрилепляемымиКоллекциями.ПолучитьПрилепляемуюКоллекцию(
		ТипЖелудя
	);

	ОпределенияЖелудей = ФабрикаЖелудей.ПолучитьСписокОпределенийЖелудей(Имя);

	Для Каждого ОпределениеЖелудя Из ОпределенияЖелудей Цикл

		Желудь = НайтиЖелудь(ОпределениеЖелудя.Имя(), ПрилепляемыеЧастицы);

		// Завязь вправе вернуть Неопределено: желудя нет, и в коллекции ему не место.
		Если Желудь = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Желудь, ОпределениеЖелудя);

	КонецЦикла;

	Возврат Результат.Получить();

КонецФункции

// Возвращает значение детальки (параметра приложения) по её имени.
//
// Параметры:
//   ИмяДетальки - Строка - Имя детальки.
//   ЗначениеПоУмолчанию - Произвольный - Значение, возвращаемое, если деталька не найдена. По умолчанию Неопределено.
//
//  Возвращаемое значение:
//   Произвольный - значение детальки либо значение по умолчанию.
//
Функция НайтиДетальку(ИмяДетальки, ЗначениеПоУмолчанию = Неопределено) Экспорт
	Возврат МенеджерПараметров.Параметр(ИмяДетальки, ЗначениеПоУмолчанию);
КонецФункции

#КонецОбласти

#Область ИнициализацияКонтекста

// Регистрирует завязь (метод-фабрику желудя) на основе переданной лямбды.
// Доступно только до запуска приложения.
//
// Параметры:
//   Лямбда - Строка, Действие - Лямбда или делегат, создающий желудь.
//   Контекст - Произвольный - Контекст выполнения лямбды. По умолчанию Неопределено.
//
//  Возвращаемое значение:
//   Завязь - созданная завязь.
//
Функция ДобавитьЗавязь(Лямбда, Контекст = Неопределено) Экспорт

	// Проверка и регистрация идут под той же блокировкой, что и запуск приложения,
	// иначе завязь, проверенная до запуска, могла бы добавиться уже после него.
	БлокировкаСостоянияПриложения.Заблокировать();

	Попытка
		ПроверитьСостояниеИнициализация();
		Завязь = ФабрикаЖелудей.ДобавитьЗавязьИзЛямбды(Лямбда, Контекст);
	Исключение
		БлокировкаСостоянияПриложения.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСостоянияПриложения.Разблокировать();

	Возврат Завязь;

КонецФункции

#КонецОбласти

// Переводит поделку из состояния инициализации в состояние выполнения
// и запускает желудь "ЗапускательПриложения".
//
Процедура ЗапуститьПриложение() Экспорт

	// Под блокировкой только смена состояния: рогатки запускаются уже без нее.
	БлокировкаСостоянияПриложения.Заблокировать();

	Попытка
		ПроверитьСостояниеИнициализация();
		СостояниеПриложения = СостоянияПриложения.Выполнение();
	Исключение
		БлокировкаСостоянияПриложения.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСостоянияПриложения.Разблокировать();

	ЗапускательПриложения = НайтиЖелудь("ЗапускательПриложения");
	ЗапускательПриложения.ЗапуститьПриложение();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнициализироватьКомпанейскийЖелудь(Имя, ПрилепляемыеЧастицы)

	Желудь = Неопределено;

	Попытка
		Желудь = ФабрикаЖелудей.НайтиЖелудь(Имя, ПрилепляемыеЧастицы);
	Исключение
		Лог.Ошибка("Не удалось инициализировать желудь %1", Имя);
		Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Желудь;

КонецФункции

Функция ИнициализироватьЖелудьОдиночку(Имя, ПрилепляемыеЧастицы)

	Желудь = ИнициализированныеЖелудиОдиночки.ПолучитьИлиУмолчание(Имя, Неопределено);
	Если Желудь <> Неопределено Тогда
		Возврат Желудь;
	КонецЕсли;

	// Одиночку создает один поток, остальные ждут его на блокировке этого имени.
	// Создание держит только ее: карта одиночек в это время свободна для других потоков.
	Блокировка = БлокировкаОдиночки(Имя);
	Блокировка.Заблокировать();

	Попытка
		Желудь = ИнициализированныеЖелудиОдиночки.ПолучитьИлиУмолчание(Имя, Неопределено);
		Если Желудь = Неопределено Тогда
			Желудь = СоздатьЖелудьОдиночку(Имя, ПрилепляемыеЧастицы);
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		Лог.Ошибка("Не удалось инициализировать желудь %1", Имя);
		Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Желудь;

КонецФункции

// Возвращает блокировку создания одиночки.
// Блокировки свои у каждой поделки, поэтому одноименные одиночки разных поделок друг друга не ждут.
//
// Параметры:
//   Имя - Строка - Имя одиночки.
//
//  Возвращаемое значение:
//   БлокировкаРесурса - блокировка создания одиночки с этим именем.
//
Функция БлокировкаОдиночки(Имя)

	Блокировка = БлокировкиОдиночек.ПолучитьИлиУмолчание(Имя, Неопределено);
	Если Блокировка <> Неопределено Тогда
		Возврат Блокировка;
	КонецЕсли;

	НоваяБлокировка = Новый БлокировкаРесурса();

	Возврат БлокировкиОдиночек.ВставитьЕслиОтсутствует(Имя, НоваяБлокировка).Иначе_(НоваяБлокировка);

КонецФункции

// Создает одиночку и запоминает ее в поделке.
// Блокировка одиночки реентерабельна, поэтому циклическую зависимость одиночек отслеживает
// цепочка создаваемых в текущем потоке одиночек. Без нее цикл ушел бы в бесконечную рекурсию.
// Цикл, который одновременно начали создавать с разных сторон два потока, так не обнаружить:
// потоки взаимно заблокируются на блокировках имен. Общая блокировка на всю поделку это бы
// исключила, но выстроила бы в очередь создание всех одиночек и заблокировала бы завязи,
// которые ждут другой поток, создающий другую одиночку.
//
// Параметры:
//   Имя - Строка - Имя одиночки.
//   ПрилепляемыеЧастицы - Массив из ПрилепляемаяЧастица, Неопределено - Зависимости, передаваемые одиночке.
//
//  Возвращаемое значение:
//   Произвольный - созданная одиночка, Неопределено, если завязь ее не вернула.
//
Функция СоздатьЖелудьОдиночку(Имя, ПрилепляемыеЧастицы)

	ДанныеПотока = ТекущийПоток().Данные;

	СоздаваемыеОдиночки = ДанныеПотока.Получить(ЭтотОбъект);
	Если СоздаваемыеОдиночки = Неопределено Тогда
		СоздаваемыеОдиночки = Новый Массив;
		ДанныеПотока.Вставить(ЭтотОбъект, СоздаваемыеОдиночки);
	КонецЕсли;

	НачалоЦикла = СоздаваемыеОдиночки.Найти(Имя);
	Если НачалоЦикла <> Неопределено Тогда
		ЦепочкаЦикла = Новый Массив;
		Для Индекс = НачалоЦикла По СоздаваемыеОдиночки.ВГраница() Цикл
			ЦепочкаЦикла.Добавить(СоздаваемыеОдиночки[Индекс]);
		КонецЦикла;
		ЦепочкаЦикла.Добавить(Имя);
		ВызватьИсключение "Циклическая зависимость одиночек: " + СтрСоединить(ЦепочкаЦикла, " -> ");
	КонецЕсли;

	СоздаваемыеОдиночки.Добавить(Имя);

	Попытка
		Желудь = ФабрикаЖелудей.НайтиЖелудь(Имя, ПрилепляемыеЧастицы);
	Исключение
		ЗавершитьСозданиеОдиночки(ДанныеПотока, СоздаваемыеОдиночки);
		ВызватьИсключение;
	КонецПопытки;

	ЗавершитьСозданиеОдиночки(ДанныеПотока, СоздаваемыеОдиночки);

	// Завязь вправе вернуть Неопределено, а карта такие значения не хранит.
	Если Желудь <> Неопределено Тогда
		ИнициализированныеЖелудиОдиночки.Вставить(Имя, Желудь);
	КонецЕсли;

	Возврат Желудь;

КонецФункции

Процедура ЗавершитьСозданиеОдиночки(ДанныеПотока, СоздаваемыеОдиночки)

	СоздаваемыеОдиночки.Удалить(СоздаваемыеОдиночки.ВГраница());

	// Данные потока живут вместе с потоком и не должны удерживать поделку.
	Если СоздаваемыеОдиночки.Количество() = 0 Тогда
		ДанныеПотока.Удалить(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

// Напильники инициализирует один поток, остальные ждут его на блокировке.
// Сам инициализирующий поток возвращается сюда из НайтиЖелудь напильников и их зависимостей:
// блокировка реентерабельна, а флаг НапильникиИнициализируются пропускает его дальше.
Процедура ПроинициализироватьНапильники()

	БлокировкаИнициализацииНапильников.Заблокировать();

	Попытка
		Если НЕ НапильникиИнициализируются Тогда
			НапильникиИнициализируются = Истина;
			ФабрикаЖелудей.ПроинициализироватьНапильники();
			НапильникиБылиПроинициализированы = Истина;
		КонецЕсли;
	Исключение
		// Иначе следующие вызовы молча пропустят инициализацию. Бросить здесь может только
		// внешний вызов: вложенные из того же потока до ФабрикаЖелудей не доходят.
		НапильникиИнициализируются = Ложь;
		БлокировкаИнициализацииНапильников.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаИнициализацииНапильников.Разблокировать();

КонецПроцедуры

Процедура ПроверитьСостояниеИнициализация()

	Если НЕ СостояниеПриложения = СостоянияПриложения.Инициализация() Тогда
		ВызватьИсключение "Приложение не находится в состоянии инициализации. Операция запрещена.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСостояниеВыполнение()

	Если НЕ СостояниеПриложения = СостоянияПриложения.Выполнение() Тогда
		ВызватьИсключение "Приложение не находится в состоянии выполнения. Операция запрещена.";
	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьМенеджерПараметров(СоветДругогоМастера)

	Строитель = СоветДругогоМастера.ПолучитьСтроительМенеджераПараметров();
	Строитель.Прочитать();

	// Поделке и внешним библиотекам нужен менеджер, а не строитель: строитель собирает
	// состав провайдеров до старта, а дальше в ходу полный интерфейс менеджера configor.
	МенеджерПараметров = Строитель.МенеджерПараметров();

КонецПроцедуры

// Создаёт контекст приложения (поделку): инициализирует фабрику желудей, контейнер аннотаций,
// менеджер параметров и сканирует известные типы.
//
// Параметры:
//   СоветДругогоМастера - СоветДругогоМастера - Настройки создания поделки. По умолчанию Неопределено — используются настройки по умолчанию.
//
Процедура ПриСозданииОбъекта(Знач СоветДругогоМастера = Неопределено)

	Если СоветДругогоМастера = Неопределено Тогда
		СоветДругогоМастера = Новый СоветДругогоМастера();
	КонецЕсли;

	КонтейнерАннотаций       = Новый КонтейнерАннотаций();
	РазворачивательАннотаций = КонтейнерАннотаций.ПолучитьРазворачивательАннотаций();

	УправляющийПрилепляемымиКоллекциями = Новый УправляющийПрилепляемымиКоллекциями();
	ПрилепляторЧастиц = Новый ПрилепляторЧастиц(ЭтотОбъект, УправляющийПрилепляемымиКоллекциями);

	ФабрикаЖелудей = Новый ФабрикаЖелудей(ЭтотОбъект, РазворачивательАннотаций, ПрилепляторЧастиц);

	ИнициализированныеЖелудиОдиночки = Новый КартаКопированиеПриЗаписи();
	БлокировкиОдиночек = Новый КартаКопированиеПриЗаписи();
	СостояниеПриложения = СостоянияПриложения.Инициализация();
	БлокировкаСостоянияПриложения = Новый БлокировкаРесурса();
	НапильникиБылиПроинициализированы = Ложь;
	НапильникиИнициализируются = Ложь;
	БлокировкаИнициализацииНапильников = Новый БлокировкаРесурса();

	Лог = Логирование.ПолучитьЛог("oscript.lib.autumn.application.context");

	ИнициализироватьМенеджерПараметров(СоветДругогоМастера);

	Осенизатор = Новый Осенизатор(ЭтотОбъект, ФабрикаЖелудей, КонтейнерАннотаций, УправляющийПрилепляемымиКоллекциями);

	Осенизатор.ПросканироватьИзвестныеТипы();

КонецПроцедуры

#КонецОбласти
