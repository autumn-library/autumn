#Использовать annotations
#Использовать reflector

Перем _Рефлектор;
Перем _ПрилепляторЧастиц;
Перем _Планы; // Соответствие: ОпределениеЖелудя -> Массив из Структура(ЭтоМетод, Имя, Данные); копия при записи.

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	Для Каждого Шаг Из План(ОпределениеЖелудя) Цикл

		ПрилепляемаяЧастица = _ПрилепляторЧастиц.НайтиПрилепляемуюЧастицу(Шаг.Данные);

		Если Шаг.ЭтоМетод Тогда
			ПараметрыМетода = Новый Массив();
			ПараметрыМетода.Добавить(ПрилепляемаяЧастица);
			_Рефлектор.ВызватьМетод(Желудь, Шаг.Имя, ПараметрыМетода);
		Иначе
			_Рефлектор.УстановитьСвойство(Желудь, Шаг.Имя, ПрилепляемаяЧастица);
		КонецЕсли;

	КонецЦикла;

	Возврат Желудь;

КонецФункции

// Что и куда прилеплять, читается из определения один раз на тип желудя.
Функция План(ОпределениеЖелудя)

	Планы = _Планы;
	План = Планы[ОпределениеЖелудя];
	Если План <> Неопределено Тогда
		Возврат План;
	КонецЕсли;

	План = Новый Массив;
	ДобавитьШаги(План, "Пластилин", ОпределениеЖелудя);
	ДобавитьШаги(План, "Деталька", ОпределениеЖелудя);

	// Компанейские желуди создаются из нескольких потоков: прочитанную карту не меняем,
	// новую запись добавляем в копию и подменяем ссылку. Два потока с одним промахом построят
	// одинаковый план, потерянную запись следующий промах восстановит.
	НовыеПланы = Новый Соответствие;
	Для Каждого КлючИЗначение Из Планы Цикл
		НовыеПланы.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	НовыеПланы.Вставить(ОпределениеЖелудя, План);
	_Планы = НовыеПланы;

	Возврат План;

КонецФункции

Процедура ДобавитьШаги(План, ИмяАннотации, ОпределениеЖелудя)

	Для Каждого Свойство Из ОпределениеЖелудя.Свойства() Цикл

		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Свойство, ИмяАннотации);
		Если Аннотация = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДанныеОПрилепляемойЧастице = _ПрилепляторЧастиц.ДанныеОПрилепляемойЧастице(Свойство);
		План.Добавить(Новый Структура("ЭтоМетод, Имя, Данные", Ложь, Свойство.Имя, ДанныеОПрилепляемойЧастице));

	КонецЦикла;

	Для Каждого Метод Из ОпределениеЖелудя.НайтиМетодыСАннотациями(ИмяАннотации) Цикл

		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, ИмяАннотации);
		Если Аннотация = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПрототипИмениПрилепляемойЧастицы = СтрЗаменить(Метод.Имя, "Установить", "");
		ДанныеОПрилепляемойЧастице = _ПрилепляторЧастиц.ДанныеОПрилепляемойЧастице(Метод, ПрототипИмениПрилепляемойЧастицы);
		План.Добавить(Новый Структура("ЭтоМетод, Имя, Данные", Истина, Метод.Имя, ДанныеОПрилепляемойЧастице));

	КонецЦикла;

КонецПроцедуры

&Напильник
&Порядок(0)
Процедура ПриСозданииОбъекта(&Пластилин ПрилепляторЧастиц)
	_Рефлектор = Новый Рефлектор();
	_ПрилепляторЧастиц = ПрилепляторЧастиц;
	_Планы = Новый Соответствие();
КонецПроцедуры
