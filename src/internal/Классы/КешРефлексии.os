#Использовать annotations
#Использовать reflector
#Использовать semaphore

// Таблицы методов и свойств типов, прочитанные один раз на поделку: сырые — для поиска аннотаций,
// развёрнутые — для определений желудей.

Перем Рефлектор;
Перем РефлекторОбъекта;
Перем РазворачивательАннотаций;
Перем Записи; // Соответствие: Тип -> Структура(Методы, Свойства, МетодыРазвернуты, СвойстваРазвернуты)
Перем Семафор; // После освобождения метаданных кеш читают из нескольких потоков.

// Таблица всех методов типа (включая неэкспортные) без разворачивания аннотаций.
//
// Параметры:
//   Тип - Тип - Тип класса.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Таблица методов в формате РефлекторОбъекта.
//
Функция СырыеМетоды(Тип) Экспорт

	Семафор.Захватить();
	Попытка
		Запись = Запись(Тип);
	Исключение
		Семафор.Освободить();
		ВызватьИсключение;
	КонецПопытки;
	Семафор.Освободить();

	Возврат Запись.Методы;

КонецФункции

// Таблица всех методов типа (включая неэкспортные) с развёрнутыми аннотациями методов.
// Аннотации разворачиваются один раз при первом обращении.
//
// Параметры:
//   Тип - Тип - Тип класса.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Таблица методов в формате РефлекторОбъекта.
//
Функция Методы(Тип) Экспорт

	Семафор.Захватить();
	Попытка
		Запись = Запись(Тип);
		Если НЕ Запись.МетодыРазвернуты Тогда
			РазворачивательАннотаций.РазвернутьАннотацииСвойств(Запись.Методы, Тип);
			Запись.МетодыРазвернуты = Истина;
		КонецЕсли;
	Исключение
		Семафор.Освободить();
		ВызватьИсключение;
	КонецПопытки;
	Семафор.Освободить();

	Возврат Запись.Методы;

КонецФункции

// Таблица всех свойств типа (включая приватные) с развёрнутыми аннотациями.
//
// Параметры:
//   Тип - Тип - Тип класса.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Таблица свойств в формате РефлекторОбъекта.
//
Функция Свойства(Тип) Экспорт

	Семафор.Захватить();
	Попытка
		Запись = Запись(Тип);
		Если Запись.Свойства = Неопределено Тогда
			// Свойства нужны только типам-желудям, предварительный проход по известным типам их не читает.
			Запись.Свойства = Рефлектор.ПолучитьТаблицуСвойств(Тип, Истина);
		КонецЕсли;
		Если НЕ Запись.СвойстваРазвернуты Тогда
			РазворачивательАннотаций.РазвернутьАннотацииСвойств(Запись.Свойства, Тип);
			Запись.СвойстваРазвернуты = Истина;
		КонецЕсли;
	Исключение
		Семафор.Освободить();
		ВызватьИсключение;
	КонецПопытки;
	Семафор.Освободить();

	Возврат Запись.Свойства;

КонецФункции

// Отпускает прочитанные таблицы всех типов; следующее обращение читает тип заново.
Процедура Очистить() Экспорт

	Семафор.Захватить();
	Записи = Новый Соответствие();
	Семафор.Освободить();

КонецПроцедуры

Функция Запись(Тип)

	Запись = Записи[Тип];
	Если Запись <> Неопределено Тогда
		Возврат Запись;
	КонецЕсли;

	РефлекторОбъекта.УстановитьОбъект(Тип);
	Методы = РефлекторОбъекта.ПолучитьТаблицуМетодов(Неопределено, Ложь);
	РефлекторОбъекта.ПолучитьКешОбъектов().Очистить();
	// Строки таблицы общие для всех обращений: аннотации параметров разворачиваются один раз, отметка — в строке метода.
	Методы.Колонки.Добавить("ПараметрыРазвернуты", Новый ОписаниеТипов("Булево"));

	Запись = Новый Структура("Методы, Свойства, МетодыРазвернуты, СвойстваРазвернуты", Методы, Неопределено, Ложь, Ложь);
	Записи.Вставить(Тип, Запись);

	Возврат Запись;

КонецФункции

Процедура ПриСозданииОбъекта(пРазворачивательАннотаций)
	РазворачивательАннотаций = пРазворачивательАннотаций;
	Рефлектор = Новый Рефлектор;
	РефлекторОбъекта = Новый РефлекторОбъекта();
	Записи = Новый Соответствие();
	Семафор = Новый Семафор();
КонецПроцедуры
