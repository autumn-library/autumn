// Многопоточные тесты выключены до исправления в движке OneScript: сборщик покрытия (CodeStatProcessor)
// хранит счетчики в словарях без блокировок, и в прогоне с покрытием параллельное исполнение одного
// модуля роняет тест исключением из движка. Без покрытия тесты проходят.
&Тест
&Выключен("До исправления гонки в сборщике покрытия движка OneScript (CodeStatProcessor)")
&Изолированный(Уровень = "Процесс", Импорты = "./МедленныйНапильник")
Процедура ЖелудьИзДругогоПотокаЖдетИнициализацииНапильников() Экспорт

	// Дано
	Поделка = Новый Поделка();
	Сигнал = Поделка.НайтиЖелудь("СигналМедленногоНапильника");
	Запуск = ФоновыеЗадания.Выполнить(Поделка, "ЗапуститьПриложение");

	// Когда
	// Запуск в фоне уже инициализирует напильники и ждет конструктор медленного напильника.
	ДождатьсяНачалаСоздания(Сигнал);
	Желудь = Поделка.НайтиЖелудь("ЖелудьДляМедленногоНапильника");
	Запуск.ОжидатьЗавершения();

	// Тогда
	Ожидаем.Что(Желудь.ОбработанНапильником, "Желудь обработан напильником, который инициализировался в другом потоке")
		.ЭтоИстина();

КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Импорты = "./ОшибочныеКлассы/ЖелудьСНекорректнымХарактером")
Процедура ПроверкаНекорректногоХарактера() Экспорт

	БылаОшибка = Ложь;

	Попытка
		Поделка = Новый Поделка(); // BSLLS:UnusedLocalVariable-off
	Исключение
		БылаОшибка = Истина;
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("Неизвестный характер желудя");
	КонецПопытки;

	Ожидаем.Что(БылаОшибка).ЭтоИстина();

КонецПроцедуры

// Ждет, пока фоновый поток войдет в конструктор медленного напильника.
//
// Параметры:
//   Сигнал - СигналМедленногоНапильника - Сигнал начала создания.
//
Процедура ДождатьсяНачалаСоздания(Сигнал)

	ТаймаутОжиданияМс = 5000;
	ИнтервалОпросаМс = 10;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока НЕ Сигнал.СозданиеНачато
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < ТаймаутОжиданияМс Цикл
		Приостановить(ИнтервалОпросаМс);
	КонецЦикла;

	Ожидаем.Что(Сигнал.СозданиеНачато, "Фоновый поток начал создавать медленный напильник")
		.ЭтоИстина();

КонецПроцедуры
