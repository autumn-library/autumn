&Тест
Процедура ПрименитьУстаревшиеНастройкиПрефиксENV() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Совет.ПрефиксПеременныхСреды("MYAPP");

	// Когда
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Тогда
	Ожидаем.Что(Строитель.Провайдер("env").Настройки().ПолучитьПрефикс())
		.Равно("MYAPP");

КонецПроцедуры

&Тест
Процедура ПрименитьУстаревшиеНастройкиИмяФайла() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Совет.ИмяФайлаСоЗначениямиДеталек("my-config");

	// Когда
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Тогда
	НастройкиJSON = Строитель.Провайдер("default-json").Настройки().ПолучитьНастройки();
	Ожидаем.Что(НастройкиJSON.НаименованияФайлаПараметров.Найти("my-config"))
		.Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПрименитьУстаревшиеНастройкиДополнительныйКаталогПоиска() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Совет.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек("custom-settings");

	// Когда
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Тогда
	НастройкиJSON = Строитель.Провайдер("default-json").Настройки().ПолучитьНастройки();
	Ожидаем.Что(НастройкиJSON.КаталогиПоиска.Количество()).Больше(0);
	Ожидаем.Что(НастройкиJSON.ВложенныйКаталог).Равно("custom-settings");

КонецПроцедуры

&Тест
Процедура ПрименитьУстаревшиеНастройкиЗначенияДеталек() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Значения = Новый Соответствие;
	Значения.Вставить("ключ", "значение");
	Совет.ЗначенияДеталек(Значения);

	// Когда
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Тогда
	Строитель.Прочитать();
	Ожидаем.Что(Строитель.Параметр("ключ")).Равно("значение");

КонецПроцедуры

&Тест
Процедура СтроительКэшируетсяИВозвращаетсяТемЖеЭкземпляром() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();

	// Когда
	ПервыйСтроитель  = Совет.ПолучитьСтроительМенеджераПараметров();
	ВторойСтроитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Тогда
	Ожидаем.Что(ВторойСтроитель).Равно(ПервыйСтроитель);

КонецПроцедуры

&Тест
Процедура ПравкиСтроителяВидныПриПовторномПолучении() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Когда
	Строитель.ОчиститьПровайдеры();
	Значения = Новый Соответствие;
	Значения.Вставить("ключ", "из-кэша");
	Строитель.ДобавитьПровайдерСоответствие(Значения, 1, "только-inline");

	СтроительИзПоделки = Совет.ПолучитьСтроительМенеджераПараметров();

	// Тогда
	Ожидаем.Что(СтроительИзПоделки.Провайдер("env")).Равно(Неопределено);
	Ожидаем.Что(СтроительИзПоделки.Провайдер("только-inline")).Не_().Равно(Неопределено);

	СтроительИзПоделки.Прочитать();
	Ожидаем.Что(СтроительИзПоделки.Параметр("ключ")).Равно("из-кэша");

КонецПроцедуры

// Смешивание старого и нового стиля обещано безопасным в любом порядке.
// Порядок "сначала строитель, потом устаревший сеттер" - обычное дело для библиотек
// (oneunit так настраивает изолированные прогоны): совет отдаёт строитель прикладному коду,
// а детальки дописывает уже сама библиотека.
&Тест
Процедура УстаревшийСеттерЗначенийДеталекПрименяетсяПослеСозданияСтроителя() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	Значения = Новый Соответствие;
	Значения.Вставить("поздняя.деталька", "применилась");

	// Когда
	Совет.ЗначенияДеталек(Значения);

	// Тогда
	Строитель.Прочитать();
	Ожидаем.Что(Строитель.Параметр("поздняя.деталька")).Равно("применилась");

КонецПроцедуры

// Соответствие отдаётся провайдеру по ссылке: значения, дописанные в него после вызова
// сеттера, обязаны доехать до менеджера параметров - на этом держатся вызывающие библиотеки.
&Тест
Процедура ЗначенияДописанныеВСоответствиеПослеСеттераВидныМенеджеру() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	Значения = Новый Соответствие;
	Совет.ЗначенияДеталек(Значения);

	// Когда
	Значения.Вставить("дописано.после", 42);

	// Тогда
	Строитель.Прочитать();
	Ожидаем.Что(Строитель.Параметр("дописано.после")).Равно(42);

КонецПроцедуры

// Повторный вызов сеттера перенастраивает тот же inline-провайдер, а не плодит новые:
// иначе состав провайдеров растёт на каждый вызов, а приоритеты становятся непредсказуемыми.
&Тест
Процедура ПовторныйВызовУстаревшегоСеттераНеПлодитПровайдеры() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	ПервыеЗначения = Новый Соответствие;
	ПервыеЗначения.Вставить("ключ", "первое");

	ВторыеЗначения = Новый Соответствие;
	ВторыеЗначения.Вставить("ключ", "второе");

	// Когда
	Совет.ЗначенияДеталек(ПервыеЗначения);
	Совет.ЗначенияДеталек(ВторыеЗначения);

	// Тогда
	Ожидаем.Что(Строитель.Провайдер("inline#2")).Равно(Неопределено);

	Строитель.Прочитать();
	Ожидаем.Что(Строитель.Параметр("ключ")).Равно("второе");

КонецПроцедуры

// Каталог поиска файла настроек тоже приезжает устаревшим сеттером после строителя.
&Тест
Процедура УстаревшийСеттерКаталогаПоискаПрименяетсяПослеСозданияСтроителя() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();

	// Когда
	Совет.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек("тесты-времянка");

	// Тогда
	Настройки = Строитель.Провайдер("default-json").Настройки().ПолучитьНастройки();
	Ожидаем.Что(Настройки.ВложенныйКаталог).Равно("тесты-времянка");

КонецПроцедуры

// Устаревший сеттер после ОчиститьПровайдеры не должен ронять совет: дефолтных провайдеров
// больше нет, применять настройку не к чему, но и исключение здесь никому не нужно.
&Тест
Процедура УстаревшийСеттерПослеОчисткиПровайдеровНеПадает() Экспорт

	// Дано
	Совет = Новый СоветДругогоМастера();
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();
	Строитель.ОчиститьПровайдеры();

	// Когда
	Совет.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек("тесты-времянка");
	Совет.ИмяФайлаСоЗначениямиДеталек("другое-имя");
	Совет.ПрефиксПеременныхСреды("PREFIX_");

	Значения = Новый Соответствие;
	Значения.Вставить("ключ", "после-очистки");
	Совет.ЗначенияДеталек(Значения);

	// Тогда
	Строитель.Прочитать();
	Ожидаем.Что(Строитель.Параметр("ключ")).Равно("после-очистки");

КонецПроцедуры

Рефлектор = Новый Рефлектор();
