#Использовать benchmark

// Пороги среднего времени выполнения одной операции в миллисекундах.
//
// Ключ - имя метода бенчмарка, значение - порог. Пороги намеренно взяты с большим
// запасом: задача - ловить кратные деградации, а не шум раннера CI.
Функция ПорогиВМиллисекундах()

	Пороги = Новый Соответствие();

	Пороги.Вставить("СозданиеКомпанейскогоЖелудя", 0.3);
	Пороги.Вставить("СозданиеКомпанейскогоЖелудяИзТабакерки", 0.3);
	Пороги.Вставить("СозданиеКомпанейскогоЖелудяСПластилиномНаПолях", 0.9);
	Пороги.Вставить("СозданиеКомпанейскогоЖелудяСПластилиномВКонструкторе", 0.9);
	Пороги.Вставить("ИнициализацияПоделки", 1000);

	Возврат Пороги;

КонецФункции

Функция КаталогБенчмарков()
	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "..", "performance_tests");
КонецФункции

Функция ПредставлениеВремени(Знач Миллисекунды)
	Возврат Формат(Миллисекунды, "ЧДЦ=3");
КонецФункции

// Проверяет результаты запуска бенчмарков на превышение порогов.
//
// Параметры:
//   РезультатыЗапусков - ТаблицаЗначений - см. Бенчмаркинг.ЗапуститьИзКаталога
//   Пороги             - Соответствие    - см. ПорогиВМиллисекундах
//
// Возвращаемое значение:
//   Массив из Строка - список проблем. Пустой массив - проверка пройдена.
Функция НайтиПроблемы(РезультатыЗапусков, Пороги)

	Проблемы = Новый Массив();
	ПроверенныеБенчмарки = Новый Массив();

	Для Каждого СтрокаРезультата Из РезультатыЗапусков Цикл

		Если Не СтрокаРезультата.Успешно Тогда
			Проблемы.Добавить(СтрШаблон(
				"Не удалось выполнить бенчмарки из файла <%1>",
				СтрокаРезультата.ПолноеИмяФайла));
			Продолжить;
		КонецЕсли;

		Для Каждого Запуск Из СтрокаРезультата.Результат.Запуски Цикл

			ИмяБенчмарка = Запуск.Кейс.ДескрипторБенчмарка().Метод();
			ПроверенныеБенчмарки.Добавить(ИмяБенчмарка);

			Порог = Пороги.Получить(ИмяБенчмарка);
			Если Порог = Неопределено Тогда
				Проблемы.Добавить(СтрШаблон(
					"Для бенчмарка <%1> не задан порог в ПорогиВМиллисекундах()",
					ИмяБенчмарка));
				Продолжить;
			КонецЕсли;

			СреднееВремя = Запуск.Статистика.ВМиллисекунды().Среднее;

			Если СреднееВремя >= Порог Тогда
				Проблемы.Добавить(СтрШаблон(
					"Бенчмарк <%1> выполняется слишком долго: %2 мс при пороге %3 мс",
					ИмяБенчмарка,
					ПредставлениеВремени(СреднееВремя),
					ПредставлениеВремени(Порог)));
			Иначе
				Сообщить(СтрШаблон(
					"OK <%1>: %2 мс (порог %3 мс)",
					ИмяБенчмарка,
					ПредставлениеВремени(СреднееВремя),
					ПредставлениеВремени(Порог)));
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Для Каждого КлючИЗначение Из Пороги Цикл
		Если ПроверенныеБенчмарки.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон(
				"Бенчмарк <%1>, для которого задан порог, не был запущен",
				КлючИЗначение.Ключ));
		КонецЕсли;
	КонецЦикла;

	Возврат Проблемы;

КонецФункции

// основной код

РезультатыЗапусков = Бенчмаркинг.ЗапуститьИзКаталога(КаталогБенчмарков());

Проблемы = НайтиПроблемы(РезультатыЗапусков, ПорогиВМиллисекундах());

Если Проблемы.Количество() > 0 Тогда
	ВызватьИсключение СтрШаблон(
		"Проверка производительности завершилась неудачно:
		|%1",
		СтрСоединить(Проблемы, Символы.ПС));
КонецЕсли;

Сообщить("Проверка производительности пройдена");
